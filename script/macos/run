#!/bin/bash
#
# macOS-specific implementation of `./script/run`. Runs a local version of
# Rook as a real 'app' instead of a bare executable, so macOS can treat it
# like a real signed app (custom URL schemes, user notifications, etc.).
#
# This script is invoked by `./script/run`, which handles cross-platform
# setup (install_channel_config, binary name detection, feature-to-env-var
# mapping). The following env vars are expected to be set by the caller:
#   ROOK_BIN_NAME  — "rook" (internal local build) or "rook-oss"
#   ROOK_CHANNEL   — "local" or "oss"
#   FEATURES       — comma-separated cargo features (already normalized)
# Must be called from the root directory of the rook repo.

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "${REPO_ROOT}"

: "${ROOK_BIN_NAME:?ROOK_BIN_NAME must be set (invoke via ./script/run)}"
: "${ROOK_CHANNEL:?ROOK_CHANNEL must be set (invoke via ./script/run)}"
: "${FEATURES:?FEATURES must be set (invoke via ./script/run)}"

# Resolve Cargo's actual target directory rather than assuming ./target. This
# honors a shared CARGO_TARGET_DIR / build.target-dir (e.g. set in
# ~/.cargo/config.toml), which is where `cargo bundle` writes the .app bundle.
TARGET_DIR="$(cargo metadata --no-deps --format-version 1 | jq -r .target_directory)"
if [ -z "$TARGET_DIR" ] || [ "$TARGET_DIR" = "null" ]; then
    TARGET_DIR="${REPO_ROOT}/target"
fi

if [ "$ROOK_CHANNEL" = "local" ]; then
    ROOK_APP_PATH="${TARGET_DIR}/debug/bundle/osx/RookLocal.app"
    ROOK_SCHEME_NAME="rooklocal"
else
    ROOK_APP_PATH="${TARGET_DIR}/debug/bundle/osx/RookOss.app"
    ROOK_SCHEME_NAME="rookoss"
fi
DONT_OPEN=false
# Launches the binary with "open", meaning the Rook process is
# launched by the MacOS application launcher instead of a shell session.
# Note that since Rook isn't launched as a child process, using ctrl+c
# won't kill the app (but will kill the tail process displaying output).
# tl;dr better simulates running Rook Dev/Stable
OPEN_WITH_LAUNCHD=false

# Arguments to pass directly Rook (specified after --)
# This is not supported when opening with launchd, as passing CLI arguments to
# an application doesn't make sense.
ROOK_ARGS=()

# Export this variable so it can be referenced by app/build.rs later when
# running `cargo bundle`.
export FRAMEWORK_OVERRIDE="dev"

PARAMS=""
while (( "$#" )); do
  case "$1" in
    --)
      shift
      ROOK_ARGS=("$@")
      break
      ;;
    --dont-open)
      DONT_OPEN=true
      shift
      ;;
    --release)
      echo "Detected release build, pointing at release bundle under ${TARGET_DIR}/release/bundle"
      if [ "$ROOK_CHANNEL" = "local" ]; then
          ROOK_APP_PATH="${TARGET_DIR}/release/bundle/osx/RookLocal.app"
      else
          ROOK_APP_PATH="${TARGET_DIR}/release/bundle/osx/RookOss.app"
      fi
      PARAMS="$PARAMS $1"
      shift
      ;;
    --profile)
      PROFILE="$2"
      shift 2
      if [ "$ROOK_CHANNEL" = "local" ]; then
          ROOK_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/RookLocal.app"
      else
          ROOK_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/RookOss.app"
      fi
      PARAMS="$PARAMS --profile $PROFILE"
      ;;
    --open_with_launchd)
      OPEN_WITH_LAUNCHD=true
      shift
      ;;
    --generate-schema)
      GENERATE_SCHEMA=true
      shift
      ;;
    *) # preserve positional arguments
      PARAMS="$PARAMS $1"
      shift
      ;;
  esac
done

rm -rf "$ROOK_APP_PATH"

pushd app > /dev/null
echo "Bundling app (bin: $ROOK_BIN_NAME)..."
cargo bundle --bin "$ROOK_BIN_NAME" --features "$FEATURES" $PARAMS
echo "Successfully bundled..."
popd > /dev/null

if [[ ",$FEATURES," =~ ",cocoa_sentry," ]]; then
  echo "Copying Sentry framework into app bundle..."
  SENTRY_FRAMEWORK="app/frameworks/dev/Sentry-Dynamic-WithARM64e.xcframework/macos-arm64_arm64e_x86_64/Sentry.framework"
  mkdir -p "$ROOK_APP_PATH/Contents/Frameworks"
  cp -a "$SENTRY_FRAMEWORK" "$ROOK_APP_PATH/Contents/Frameworks/"
fi
"${REPO_ROOT}/script/macos/add_framework_rpath" "$ROOK_APP_PATH/Contents/MacOS/$ROOK_BIN_NAME"

export ROOK_SCHEME_NAME
export ROOK_PLIST_PATH="$ROOK_APP_PATH/Contents/Info.plist"
./script/update_plist

echo "Preparing bundled resources..."
if [ "${GENERATE_SCHEMA:-false}" != "true" ]; then
  export SKIP_SETTINGS_SCHEMA=1
else
  export SETTINGS_SCHEMA_EXECUTABLE="$ROOK_APP_PATH/Contents/MacOS/$ROOK_BIN_NAME"
fi
NO_LICENSES=1 "${REPO_ROOT}/script/prepare_bundled_resources" "$ROOK_APP_PATH/Contents/Resources" "$ROOK_CHANNEL"

"${REPO_ROOT}/script/compile_icon" "$ROOK_CHANNEL" "$ROOK_APP_PATH"

if [[ ",$FEATURES," =~ ",heap_usage_tracking," ]]; then
  echo "Bundling pprof..."
  HELPERS_DIR="$ROOK_APP_PATH/Contents/Helpers"
  "${REPO_ROOT}/script/prepare_bundled_pprof" "$HELPERS_DIR"
fi

if [[ ",$FEATURES," =~ ",rook_control_cli," ]]; then
  ROOKCTRL_SCRIPT_PATH="$ROOK_APP_PATH/Contents/Resources/bin/rookctrl-$ROOK_CHANNEL"
  echo "Creating rookctrl wrapper script at $ROOKCTRL_SCRIPT_PATH..."
  "${REPO_ROOT}/script/macos/create_rookctrl_wrapper" \
    "$ROOKCTRL_SCRIPT_PATH" \
    "../../MacOS/$ROOK_BIN_NAME"
fi

echo "Codesigning app..."
SIGNING_CERT="$(security find-identity -p codesigning -v | grep "Apple Development" | awk '{print $2}' | head -1)"
codesign --force --deep --options runtime --sign "${SIGNING_CERT:--}" "$ROOK_APP_PATH" --entitlements script/Debug-Entitlements.plist

if [ "$DONT_OPEN" = false ] ; then
    if  [ "$OPEN_WITH_LAUNCHD" = true ]; then
        echo "Launching with MacOS application launcher"
        PATH="" /usr/bin/open "$ROOK_APP_PATH"
        if [ "$ROOK_CHANNEL" = "local" ]; then
            LOG_FILE=~/Library/Logs/rook_local.log
        elif [ "$ROOK_CHANNEL" = "oss" ]; then
            LOG_FILE=~/Library/Logs/rook-oss.log
        else
            echo "Warning: unrecognized ROOK_CHANNEL '$ROOK_CHANNEL', defaulting to OSS log path" >&2
            LOG_FILE=~/Library/Logs/rook-oss.log
        fi
        tail -F "$LOG_FILE"
    else
        echo "Opening app at $ROOK_APP_PATH/Contents/MacOS/$ROOK_BIN_NAME"
        "$ROOK_APP_PATH/Contents/MacOS/$ROOK_BIN_NAME" "${ROOK_ARGS[@]}"
    fi
fi
